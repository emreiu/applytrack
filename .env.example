# Copy to .env for local development. Not read by the backend directly (that
# happens via E1-S02 profiles) — this only feeds docker-compose.yml's local
# PostgreSQL container. Values here match the backend's local defaults so
# `docker compose up` and `./mvnw spring-boot:run` work together untouched.
POSTGRES_DB=applytrack
POSTGRES_USER=applytrack
POSTGRES_PASSWORD=applytrack
